  "tokenColors": [
    {
      "scope": [
        "punctuation",
        "meta.bracket",
        "meta.brace",
        "punctuation.section.braces",
        "punctuation.section.brackets",
        "meta.parenthesis",
        "punctuation.section.parens"
      ],
      "settings": {
        "foreground": "#cececeff"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "storage.type",
        "meta.link"
      ],
      "settings": {
        "foreground": "#c897ffff"
      }
    },
    {
      "scope": [
        "keyword.operator.namespace"
      ],
      "settings": {
        "foreground": "#cececeff"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#636363ff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.name.type.alias",
        "support.type",
        "entity.name.struct",
        "support.type.struct",
        "markup.inline.raw",
        "storage.type"
      ],
      "settings": {
        "foreground": "#7fe6bdff"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9e4900ff"
      }
    },
    {
      "scope": [
        "meta.tag.attributes",
        "support.type.property-name.toml",
        "support.type.property-name.array",
        "support.type.property-name.table"
      ],
      "settings": {
        "foreground": "#cececeff"
      }
    },
    {
      "scope": [
        "support.class.component",
        "entity.other.attribute-name.pseudo-element",
        "entity.other.attribute-name.pseudo-class"
      ],
      "settings": {
        "foreground": "#7fe6bdff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.macro",
        "entity.other.attribute-name.class",
        "heading"
      ],
      "settings": {
        "foreground": "#72deffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "constant.numeric",
        "support.constant.property-value",
        "markup.bold",
        "constant.language.json",
        "constant.language.powershell"
      ],
      "settings": {
        "foreground": "#ff92ffff"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c897ffff"
      }
    },
    {
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#cececeff"
      }
    },
    {
      "scope": [
        "variable.annotation",
        "meta.decorator",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "entity.name.function.call",
        "support.function.call"
      ],
      "settings": {
        "foreground": "#afe173ff"
      }
    },
    {
      "scope": [
        "comment.documentation"
      ],
      "settings": {
        "foreground": "#636363ff"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#636363ff",
    "type": "#7fe6bdff",
    "typeAlias": "#7fe6bdff",
    "typeParameter": "#7fe6bdff",
    "function": {
      "bold": true,
      "foreground": "#72deffff"
    },
    "method": "#72deffff",
    "const": "#ff92ffff",
    "enum": "#7fe6bdff",
    "enumMember": "#ff92ffff",
    "string": "#afe173ff",
    "operator": "#c897ffff",
    "keyword": "#c897ffff",
    "macro": "#72deffff",
    "deriveHelper": "#7fe6bdff",
    "decorator": "#afe173ff",
    "punctuation": "#636363ff",
    "brace": "#636363ff",
    "bracket": "#cececeff",
    "parenthesis": "#cececeff",
    "number": "#ff92ffff",
    "struct": "#7fe6bdff",
    "variable.defaultLibrary": {
      "underline": true
    },
    "*.documentation": "#636363ff",
    "*.constant": "#ff92ffff",
    "*.callable": "#afe173ff",
    "*.modification": {
      "bold": true
    },
    "*.readonly": {
      "bold": true
    },
    "label": "#ff92ffff"
  }
}