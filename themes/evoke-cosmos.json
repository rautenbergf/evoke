	"tokenColors": [
		{
			"scope": [
				"punctuation",
				"meta.bracket",
				"meta.brace",
				"punctuation.section.braces",
				"punctuation.section.brackets",
				"meta.parenthesis",
				"punctuation.section.parens"
			],
			"settings": {
				"foreground": "#cececeff"
			}
		},
		{
			"scope": ["keyword.operator", "storage.type", "meta.link"],
			"settings": {
				"foreground": "#00ff7cff"
			}
		},
		{
			"scope": ["keyword.operator.namespace"],
			"settings": {
				"foreground": "#cececeff"
			}
		},
		{
			"scope": ["comment"],
			"settings": {
				"foreground": "#636363ff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"entity.name.type.alias",
				"support.type",
				"entity.name.struct",
				"support.type.struct",
				"markup.inline.raw",
				"storage.type"
			],
			"settings": {
				"foreground": "#a9cdffff"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#007a00ff"
			}
		},
		{
			"scope": [
				"meta.tag.attributes",
				"support.type.property-name.toml",
				"support.type.property-name.array",
				"support.type.property-name.table"
			],
			"settings": {
				"foreground": "#cececeff"
			}
		},
		{
			"scope": [
				"support.class.component",
				"entity.other.attribute-name.pseudo-element",
				"entity.other.attribute-name.pseudo-class"
			],
			"settings": {
				"foreground": "#a9cdffff"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"variable.function",
				"entity.name.macro",
				"entity.other.attribute-name.class",
				"heading"
			],
			"settings": {
				"foreground": "#7ddbffff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"variable.other.enummember",
				"constant.numeric",
				"support.constant.property-value",
				"markup.bold",
				"constant.language.json",
				"constant.language.powershell"
			],
			"settings": {
				"foreground": "#00f3ffff"
			}
		},
		{
			"scope": ["keyword", "keyword.operator"],
			"settings": {
				"foreground": "#00ff7cff"
			}
		},
		{
			"scope": ["support.type.property-name"],
			"settings": {
				"foreground": "#cececeff"
			}
		},
		{
			"scope": [
				"variable.annotation",
				"meta.decorator",
				"punctuation.definition.string",
				"string.quoted",
				"string.template",
				"entity.name.function.call",
				"support.function.call"
			],
			"settings": {
				"foreground": "#ffa6efff"
			}
		},
		{
			"scope": ["comment.documentation"],
			"settings": {
				"foreground": "#636363ff"
			}
		},
		{
			"scope": ["storage.modifier"],
			"settings": {
				"fontStyle": "bold"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"comment": "#636363ff",
		"type": "#a9cdffff",
		"typeAlias": "#a9cdffff",
		"typeParameter": "#a9cdffff",
		"function": {
			"bold": true,
			"foreground": "#7ddbffff"
		},
		"method": "#7ddbffff",
		"const": "#00f3ffff",
		"enum": "#a9cdffff",
		"enumMember": "#00f3ffff",
		"string": "#ffa6efff",
		"operator": "#00ff7cff",
		"keyword": "#00ff7cff",
		"macro": "#7ddbffff",
		"deriveHelper": "#a9cdffff",
		"decorator": "#ffa6efff",
		"punctuation": "#636363ff",
		"brace": "#636363ff",
		"bracket": "#cececeff",
		"parenthesis": "#cececeff",
		"number": "#00f3ffff",
		"struct": "#a9cdffff",
		"variable.defaultLibrary": {
			"underline": true
		},
		"*.documentation": "#636363ff",
		"*.constant": "#00f3ffff",
		"*.callable": "#ffa6efff",
		"*.modification": {
			"bold": true
		},
		"*.readonly": {
			"bold": true
		},
		"label": "#00f3ffff"
	}
}
