{
	"$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
	"vcs": {
		"useIgnoreFile": true,
		"clientKind": "git",
		"enabled": true
	},
	"files": {
		"includes": ["*", "**"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noExtraBooleanCast": "warn",
				"noBannedTypes": "off",
				"noForEach": "off"
			},
			"correctness": {
				"recommended": true
			},
			"performance": {
				"noDelete": "warn"
			},
			"suspicious": {
				"noDoubleEquals": "error",
				"recommended": true,
				"noExplicitAny": "off"
			},
			"a11y": {
				"useKeyWithClickEvents": "off",
				"noSvgWithoutTitle": "off",
				"useAltText": "off",
				"noAutofocus": "off"
			},
			"style": {
				"noParameterAssign": "off",
				"useTemplate": "warn",
				"useBlockStatements": "warn",
				"noUnusedTemplateLiteral": "warn",
				"noNonNullAssertion": "off",
				"useImportType": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"root": true,
	"javascript": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single",
			"quoteProperties": "asNeeded",
			"semicolons": "asNeeded"
		}
	}
}
